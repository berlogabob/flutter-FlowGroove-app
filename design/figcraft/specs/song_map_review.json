        {
          "t": "row",
          "gap": 8,
          "main": "max",
          "c": [
            {
              "t": "button",
              "v": "Stretch to 80",
              "kind": "secondary",
              "size": "small"
            },
            {
              "t": "button",
              "v": "Keep",
              "kind": "text",
              "size": "small"
            }
          ]
        }
      ]
