{
  "name": "Song Map Review",
  "page": "Song Map",
  "mode": "dark",
  "source": "lib/screens/practice_regions_screen.dart",
  "slot": 6,
  "pad": [
    12,
    16,
    12,
    16
  ],
  "gap": 12,
  "top": [
    {
      "t": "appbar",
      "v": "Inocente",
      "sub": "Review sections",
      "actions": [
        "more_vert"
      ]
    }
  ],
  "body": [
    {
      "t": "card",
      "name": "Review banner",
      "bg": "surfaceRaised",
      "border": "borderSubtle",
      "radius": 12,
      "pad": 12,
      "gap": 4,
      "c": [
        {
          "t": "text",
          "v": "10 sections found · check, then Done",
          "style": "titleMedium",
          "color": "textPrimary"
        },
        {
          "t": "text",
          "v": "Review the suggested boundaries before saving your map.",
          "style": "bodySmall",
          "color": "textSecondary"
        }
      ]
    },
    {
      "t": "section",
      "v": "Suggested map",
      "action": "Edit"
    },
    {
      "t": "row",
      "wrap": true,
      "gap": 8,
      "c": [
        {
          "t": "secblock",
          "name": "Intro",
          "letter": "A",
          "color": "section1",
          "w": 112,
          "state": "candidate"
        },
        {
          "t": "secblock",
          "name": "Verse 1",
          "letter": "B",
          "color": "section2",
          "w": 112,
          "state": "candidate"
        },
        {
          "t": "secblock",
          "name": "Chorus 1",
          "letter": "C",
          "color": "section5",
          "w": 112,
          "state": "candidate"
        },
        {
          "t": "secblock",
          "name": "Verse 2",
          "letter": "D",
          "color": "section2",
          "w": 112,
          "state": "candidate"
        },
        {
          "t": "secblock",
          "name": "Chorus 2",
          "letter": "E",
          "color": "section5",
          "w": 112,
          "state": "candidate"
        },
        {
          "t": "secblock",
          "name": "Bridge",
          "letter": "F",
          "color": "section7",
          "w": 112,
          "state": "candidate"
        },
        {
          "t": "secblock",
          "name": "Chorus 3",
          "letter": "G",
          "color": "section5",
          "w": 112,
          "state": "candidate"
        },
        {
          "t": "secblock",
          "name": "Break",
          "letter": "H",
          "color": "section8",
          "w": 112,
          "state": "candidate"
        },
        {
          "t": "secblock",
          "name": "Chorus 4",
          "letter": "I",
          "color": "section5",
          "w": 112,
          "state": "candidate"
        },
        {
          "t": "secblock",
          "name": "Outro",
          "letter": "J",
          "color": "section1",
          "w": 112,
          "state": "candidate"
        }
      ]
    },
    {
      "t": "text",
      "v": "Tap a section to rename it or adjust its boundary.",
      "style": "bodySmall",
      "color": "textSecondary"
    },
    {
      "t": "divider"
    },
    {
      "t": "card",
      "name": "New map banner",
      "bg": "surfaceRaised",
      "border": "borderSubtle",
      "radius": 12,
      "pad": 12,
      "gap": 8,
      "c": [
        {
          "t": "text",
          "v": "New map: Keep old / Use new",
          "style": "bodyMedium",
          "color": "textPrimary"
        },
        {
          "t": "row",
          "gap": 8,
          "main": "max",
          "c": [
            {
              "t": "button",
              "v": "Keep old",
              "kind": "secondary",
              "size": "small"
            },
            {
              "t": "button",
              "v": "Use new",
              "kind": "primary",
              "size": "small"
            }
          ]
        }
      ]
    },
    {
      "t": "card",
      "name": "Tempo banner",
      "bg": "surfaceRaised",
      "border": "borderSubtle",
      "radius": 12,
      "pad": 12,
      "gap": 8,
      "c": [
        {
          "t": "text",
          "v": "Audio runs at 80.49 BPM · Stretch to 80 / Keep",
          "style": "bodyMedium",
          "color": "textPrimary"
