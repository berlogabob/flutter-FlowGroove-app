# functions/.env — loaded automatically by the Firebase CLI for both
# defineString params and process.env. Copy to functions/.env and fill in.
#
# NEVER commit functions/.env. It is covered by the root .gitignore (`.env`),
# and the pre-commit hook greps for SPOTIFY / AIzaSy / google-services.
#
# Values marked SECRET should live in Secret Manager rather than this file:
#   firebase functions:secrets:set <NAME>
# A bound secret is exposed to the function as process.env at runtime, so the
# code path is identical either way — see src/metadata/credentials.js.

# --- Telegram bot (defineString params, see src/telegram/config.js) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SUPPORT_GROUP_ID=
ADMIN_IDS=

# --- Remote MCP OAuth (see mcp/REMOTE_SETUP.md) -----------------------------
# Identity provider for the app.flowgroove.app/mcp connector. Dropping custom
# scopes and registering the resource indicator in the provider dashboard are
# both required — see mcp/REMOTE_SETUP.md before changing these.
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=
MCP_RESOURCE_URL=
MCP_JWKS_URL=
# SECRET — still read from this file today. To migrate:
#   firebase functions:secrets:set WORKOS_API_KEY
#   add `secrets: [WORKOS_API_KEY]` to the mcpRemote function options
#   delete the line below
# Do the secret-set FIRST; deploying a declaration for a secret that does not
# exist yet fails, and this is the connector's auth path.
WORKOS_API_KEY=

# --- Spotify (metadata resolver) --------------------------------------------
# SECRET — used server-side only, via client_credentials. The client secret must
# never reach the Flutter bundle; that is why the resolver lives in functions/.
# Note: /audio-features and /recommendations are unavailable to this app (403 /
# 404 — Development mode, post-Nov-2024 deprecation), so Spotify supplies album,
# release year, ISRC, duration and track id, but NOT bpm or key.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
