# FlowGroove Local Development Environment Configuration
# ============================================================
#
# This file is for LOCAL DEVELOPMENT ONLY
# Copy this file to .env and fill in your credentials
#
# DO NOT COMMIT this file to git - it's already in .gitignore
#
# For CI/CD deployment, set these as environment variables
# in your CI/CD platform (GitHub Actions secrets, etc.)

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here

# Spotify API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Spotify Proxy (optional, recommended for production)
# SPOTIFY_PROXY_URL=https://your-backend.com/api/spotify

# Twitter/X API Credentials (optional)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here

# Track Analysis API - RapidAPI (optional)
TRACK_ANALYSIS_API_KEY=your_rapidapi_key_here

# FTP Deployment Credentials (for make deploy-stable)
FTP_HOST=194.39.124.68
FTP_USER=sounding
FTP_PASS=your_ftp_password_here
FTP_DIR=flowgroove.app
