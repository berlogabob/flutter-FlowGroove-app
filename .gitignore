# Miscellaneous
*.class
*.lock
*.log
*.pyc
*.swp
.DS_Store
.buildlog/
.history

# Environment variables (contains secrets)
.env
.env.*
.ftp-env
assets/env.json
assets/env.json.local
web/config.js
web/config.local.js

# Flutter web app build artifacts (in docs/app/)
docs/app/

# Hugo build output (generated, not tracked)
site/public/

# Editor temp files (vim, emacs, etc.)
.*!
!*~
\#*\#

# Hugo static assets are tracked; build output is not
docs/canvaskit/
docs/flutter.js

# Chat exports (automatically moved to docs/archive/)
chat-export-*.json
chat-exports-collection/
console-export-*.log
qwen-code-export-*.md
*-export-*.json

# IDE / local tool state
.idea/
*.iml
.firebase/

# Local archive stays out of git except the index note
oldarchive/*
!oldarchive/README.md

# Local archives / snapshots (kept on disk, not in git)
backup/
test_hive/
graphify-venv/
graphify-out/
/2026-*.txt
/Grok-*.json

# Local migration dry-run reports
migration-reports/
functions/migration-reports/



