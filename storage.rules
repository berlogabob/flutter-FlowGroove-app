rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Personal avatars live at profile_pictures/{uid}.jpg (flat, single
    // segment). Match the filename and compare it to the owner's uid so the
    // flat .jpg object is authorized correctly.
    match /profile_pictures/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        fileName == request.auth.uid + '.jpg';
      allow delete: if request.auth != null &&
        fileName == request.auth.uid + '.jpg';
    }

    // Band avatars live at band_avatars/{bandId} (no extension) so the
    // {bandId} wildcard binds to the real band document id, which is then
    // used to look up the band's admins. Only band admins may write/delete.
    match /band_avatars/{bandId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null &&
        firestore.get(/databases/(default)/documents/bands/$(bandId))
          .data.adminUids.hasAny([request.auth.uid]);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
